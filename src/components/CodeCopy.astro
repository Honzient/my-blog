<!--
  Injects a header bar into every Shiki-rendered <pre> code block.
  Left: language label. Right: one-click copy button.
-->
<script>
  document.querySelectorAll('.prose pre').forEach((pre) => {
    // Wrap in a relative container for absolute positioning of the header
    const wrapper = document.createElement('div');
    wrapper.className = 'relative group/code';
    wrapper.setAttribute('data-code-wrapper', '');
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    // --- Header bar ---
    const header = document.createElement('div');
    header.className = 'code-block-header';

    // Language label (left)
    const code = pre.querySelector('code');
    const lang = code?.className?.match(/language-(\w+)/)?.[1] ?? 'code';
    const langLabel = document.createElement('span');
    langLabel.className = 'code-lang';
    langLabel.textContent = lang;
    header.appendChild(langLabel);

    // Copy button (right)
    const copyBtn = document.createElement('button');
    copyBtn.className = 'code-copy-btn';
    copyBtn.innerHTML = `
      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
      </svg>
      <span>Copy</span>`;
    copyBtn.title = 'Copy code';

    copyBtn.addEventListener('click', async () => {
      const text = pre.textContent || '';
      await navigator.clipboard.writeText(text);
      copyBtn.innerHTML = `
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        <span>Copied</span>`;
      setTimeout(() => {
        copyBtn.innerHTML = `
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
          </svg>
          <span>Copy</span>`;
      }, 1500);
    });

    header.appendChild(copyBtn);
    wrapper.insertBefore(header, pre);
  });
</script>
