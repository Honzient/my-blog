---
import { t, type Locale } from '../i18n/ui';

export interface Props {
  allTags: string[];
  placeholder: string;
  locale: Locale;
}
const { allTags, placeholder, locale } = Astro.props;
---

<div id="search-root" class="rounded-xl bg-white/70 dark:bg-neutral-800/50 backdrop-blur-xl border border-white/20 dark:border-neutral-700/30 p-5 shadow-[0_0_0_1px_rgba(0,0,0,0.02),0_2px_8px_rgba(0,0,0,0.04)] dark:shadow-[0_0_0_1px_rgba(255,255,255,0.01),0_2px_8px_rgba(0,0,0,0.2)]">
  <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-3">{t(locale, 'search.title')}</p>

  <div class="relative mb-4">
    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-neutral-400 dark:text-neutral-500 pointer-events-none"
         fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/>
    </svg>
    <input id="search-input" type="text" placeholder={placeholder}
      class="w-full pl-9 pr-3 py-2 text-sm rounded-lg
             bg-neutral-50 dark:bg-neutral-700/40
             border border-neutral-200/60 dark:border-neutral-600/40
             text-neutral-800 dark:text-neutral-200
             placeholder:text-neutral-400 dark:placeholder:text-neutral-500
             focus:outline-none focus:border-neutral-400 dark:focus:border-neutral-500
             transition-colors duration-200"/>
  </div>

  <p class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-2">{t(locale, 'search.tags')}</p>
  <div class="flex flex-wrap gap-1.5 mb-4" id="tag-filters">
    {allTags.map((tag) => (
      <button data-tag={tag}
        class="tag-chip inline-flex items-center text-[11px] font-medium px-2 py-0.5 rounded-full
               text-neutral-500 dark:text-neutral-400
               bg-neutral-100 dark:bg-neutral-700/50
               hover:bg-neutral-200 dark:hover:bg-neutral-600
               transition-colors duration-150 cursor-pointer border-none">
        #{tag}
      </button>
    ))}
  </div>

  <!-- Year quick-filters — populated by JS from search data -->
  <p class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-2">{t(locale, 'search.date')}</p>
  <div class="flex flex-wrap gap-1.5" id="year-filters">
    <button data-year="" class="year-chip text-[11px] font-medium px-2 py-0.5 rounded-full text-neutral-500 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-700/50 hover:bg-neutral-200 dark:hover:bg-neutral-600 transition-colors duration-150 cursor-pointer border-none !bg-neutral-900 !text-white dark:!bg-neutral-300 dark:!text-neutral-900">
      {t(locale, 'search.all')}
    </button>
  </div>

  <p id="results-info" class="mt-3 text-[11px] text-neutral-400 dark:text-neutral-500 hidden"></p>
</div>

<script>
  import { initSearch } from '../lib/search.js';
  initSearch();
</script>
