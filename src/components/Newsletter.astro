---
import { t, type Locale } from '../i18n/ui';

interface Props { locale: Locale; }
const { locale } = Astro.props;
---

<div class="mt-20 rounded-xl bg-white/70 dark:bg-neutral-800/50 backdrop-blur-xl border border-white/20 dark:border-neutral-700/30 p-8 text-center">
  <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-200 mb-2">
    {t(locale, 'newsletter.title')}
  </h3>
  <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-5 max-w-sm mx-auto">
    {t(locale, 'newsletter.text')}
  </p>
  <form class="flex gap-2 max-w-sm mx-auto" onsubmit="(function(e){e.preventDefault();alert('Newsletter functionality coming soon!')})(event)">
    <input
      type="email"
      placeholder={t(locale, 'newsletter.placeholder')}
      class="flex-1 px-3.5 py-2 text-sm rounded-lg
             bg-neutral-50 dark:bg-neutral-700/40
             border border-neutral-200/60 dark:border-neutral-600/40
             text-neutral-800 dark:text-neutral-200
             placeholder:text-neutral-400 dark:placeholder:text-neutral-500
             focus:outline-none focus:border-neutral-400 dark:focus:border-neutral-500
             transition-colors duration-200"
    />
    <button
      type="submit"
      class="px-4 py-2 text-sm font-medium rounded-lg
             bg-neutral-900 dark:bg-neutral-200
             text-white dark:text-neutral-900
             hover:bg-neutral-700 dark:hover:bg-neutral-400
             transition-colors duration-200 cursor-pointer border-none shrink-0"
    >
      {t(locale, 'newsletter.button')}
    </button>
  </form>
</div>
