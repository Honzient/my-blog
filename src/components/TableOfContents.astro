---
import { t, type Locale } from '../i18n/ui';

export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  locale: Locale;
}

const { headings, locale } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{items.length > 0 && (
  <nav class="rounded-xl bg-white/70 dark:bg-neutral-800/50 backdrop-blur-xl border border-white/20 dark:border-neutral-700/30 p-4 text-sm">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-3">
      {t(locale, 'toc.heading')}
    </p>
    <ul class="space-y-1.5">
      {items.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            class:list={[
              'block text-neutral-500 dark:text-neutral-400 no-underline hover:text-neutral-900 dark:hover:text-neutral-200 transition-colors duration-150',
              h.depth === 3 ? 'pl-3 text-xs' : 'text-[13px]',
            ]}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
