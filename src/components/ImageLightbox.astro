---
import { t, type Locale } from '../i18n/ui';

interface Props { locale: Locale; }
const { locale } = Astro.props;
---

<!-- Click-to-enlarge for images inside .prose content -->
<div
  id="lightbox"
  class="fixed inset-0 z-[70] bg-black/80 backdrop-blur-sm flex items-center justify-center hidden cursor-zoom-out"
  role="dialog"
  aria-modal="true"
  aria-label={t(locale, 'lightbox.title')}
>
  <button
    id="lightbox-close"
    type="button"
    class="absolute top-4 right-4 inline-flex items-center justify-center w-9 h-9 rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors cursor-pointer border-none"
    aria-label={t(locale, 'lightbox.close')}
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>
  <img id="lightbox-img" class="max-h-[90vh] max-w-[90vw] rounded-xl shadow-2xl" src="" alt="" />
</div>

<script>
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close');
  if (!lightbox || !lightboxImg) throw new Error('lightbox markup missing');

  const lb = lightbox;
  const lbImg = lightboxImg;

  let lastFocused: HTMLElement | null = null;

  function openLightbox(img: HTMLImageElement) {
    lastFocused = document.activeElement as HTMLElement;
    lbImg.src = img.src;
    lbImg.alt = img.alt;
    lb.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
    closeBtn?.focus();
  }

  function closeLightbox() {
    lb.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
    lastFocused?.focus();
  }

  document.querySelectorAll('.prose img').forEach((img) => {
    (img as HTMLImageElement).style.cursor = 'zoom-in';
    img.addEventListener('click', () => openLightbox(img as HTMLImageElement));
  });

  lb.addEventListener('click', (e) => {
    if (e.target === lb) closeLightbox();
  });
  closeBtn?.addEventListener('click', closeLightbox);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !lb.classList.contains('hidden')) {
      closeLightbox();
    }
  });
</script>