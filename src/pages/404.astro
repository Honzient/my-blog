---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';
const locale = 'zh' as const;
---

<BaseLayout title={`${t(locale, '404.title')} — ${t(locale, 'site.title')}`} locale={locale}>
  <div class="text-center py-24">
    <p class="text-8xl font-bold text-neutral-200 dark:text-neutral-700 mb-6">404</p>
    <h1 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100 mb-3">{t(locale, '404.title')}</h1>
    <p class="text-neutral-500 dark:text-neutral-400 mb-8">{t(locale, '404.text')}</p>
    <a href="/" class="inline-block px-5 py-2 text-sm font-medium rounded-lg bg-neutral-900 dark:bg-neutral-200 text-white dark:text-neutral-900 hover:bg-neutral-700 dark:hover:bg-neutral-400 transition-colors no-underline">{t(locale, '404.back')}</a>
  </div>
</BaseLayout>
