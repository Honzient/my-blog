---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';
const locale = 'zh' as const;
---

<BaseLayout
  title={`${t(locale, '404.title')} — ${t(locale, 'site.title')}`}
  description={t(locale, '404.text')}
  locale={locale}
>
  <div class="text-center py-24">
    <p class="text-8xl font-bold text-neutral-200 dark:text-neutral-700 mb-6">404</p>
    <h1 id="e404-title" class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100 mb-3">{t(locale, '404.title')}</h1>
    <p id="e404-text" class="text-neutral-700 dark:text-neutral-400 mb-8">{t(locale, '404.text')}</p>
    <a id="e404-back" href="/" class="inline-block px-5 py-2 text-sm font-medium rounded-lg bg-neutral-900 dark:bg-neutral-200 text-white dark:text-neutral-900 hover:bg-neutral-700 dark:hover:bg-neutral-400 transition-colors no-underline">{t(locale, '404.back')}</a>
  </div>
</BaseLayout>

<script is:inline>
  // Static 404.html serves every locale — swap copy for /en/* paths.
  (function () {
    if (!location.pathname.startsWith('/en')) return;
    var copy = {
      title: 'Page not found',
      text: 'The page you\'re looking for doesn\'t exist or has been moved.',
      back: 'Back to home',
    };
    var titleEl = document.getElementById('e404-title');
    var textEl = document.getElementById('e404-text');
    var backEl = document.getElementById('e404-back');
    if (titleEl) titleEl.textContent = copy.title;
    if (textEl) textEl.textContent = copy.text;
    if (backEl) {
      backEl.textContent = copy.back;
      backEl.setAttribute('href', '/en/');
    }
  })();
</script>