---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import CopyLinkButton from '../../components/CopyLinkButton.astro';
import CodeCopy from '../../components/CodeCopy.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import { t, type Locale } from '../../i18n/ui';
import { formatDate, toISODate } from '../../lib/date';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, publishedAt, updatedAt, tags } = post.data;
const { Content, headings = [] } = await render(post);

const locale: Locale = 'zh';

// Prev/next navigation — newest first
const allPosts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const postIndex = allPosts.findIndex((p) => p.id === post.id);
const newerPost = postIndex > 0 ? allPosts[postIndex - 1] : undefined;
const olderPost = postIndex >= 0 && postIndex < allPosts.length - 1 ? allPosts[postIndex + 1] : undefined;

// Structured data for rich results
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: toISODate(publishedAt),
  ...(updatedAt ? { dateModified: toISODate(updatedAt) } : {}),
  inLanguage: locale,
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.title },
  mainEntityOfPage: new URL(Astro.url.pathname, SITE.url).href,
};
---

<BaseLayout
  title={`${title} — ${t(locale, 'site.title')}`}
  description={description}
  currentPath={Astro.url.pathname}
  locale={locale}
  jsonLd={jsonLd}
>
  <ReadingProgress />

  <article>
    <header class="mb-14">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-neutral-600 dark:text-neutral-500 font-mono tracking-tight mb-3">
        <time datetime={toISODate(publishedAt)}>
          {formatDate(publishedAt, 'zh', 'full')}
        </time>
        {updatedAt && (
          <>
            <span class="text-neutral-400 dark:text-neutral-500" aria-hidden="true">&middot;</span>
            <time datetime={toISODate(updatedAt)}>
              {t(locale, 'post.updated')} {formatDate(updatedAt, 'zh', 'full')}
            </time>
          </>
        )}
      </div>

      <div class="flex items-start gap-1">
        <h1 class="text-3xl font-bold tracking-tight text-neutral-900 leading-tight dark:text-neutral-100">
          {title}
        </h1>
        <CopyLinkButton locale={locale} />
      </div>

      {tags && tags.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a href={`/tags/${tag}`} class="inline-flex items-center text-[11px] font-medium px-2 py-0.5 rounded-full no-underline text-neutral-700 dark:text-neutral-300 bg-neutral-200/70 dark:bg-neutral-700/50 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-300 dark:hover:bg-neutral-600 transition-colors duration-150">
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-neutral max-w-3xl mx-auto prose-img:rounded-xl prose-blockquote:font-normal prose-blockquote:not-italic prose-blockquote:border-l-2 prose-li:marker:text-neutral-300 dark:prose-li:marker:text-neutral-600">
      <Content />
    </div>
  </article>

  <div class="mt-20 mb-12 h-px bg-gradient-to-r from-transparent via-neutral-300/60 to-transparent dark:via-neutral-700" />

  <!-- Prev / next -->
  <nav class="mb-12 grid grid-cols-2 gap-4" aria-label={t(locale, 'archive.title')}>
    {olderPost ? (
      <a href={`/posts/${olderPost.id}`} class="group no-underline">
        <span class="block text-xs text-neutral-600 dark:text-neutral-400 mb-1">&larr; {t(locale, 'post.prev')}</span>
        <span class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 group-hover:text-neutral-900 dark:group-hover:text-neutral-100 line-clamp-2 transition-colors duration-200">{olderPost.data.title}</span>
      </a>
    ) : (
      <span aria-hidden="true"></span>
    )}
    {newerPost ? (
      <a href={`/posts/${newerPost.id}`} class="group no-underline text-right">
        <span class="block text-xs text-neutral-600 dark:text-neutral-400 mb-1">{t(locale, 'post.next')} &rarr;</span>
        <span class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 group-hover:text-neutral-900 dark:group-hover:text-neutral-100 line-clamp-2 transition-colors duration-200">{newerPost.data.title}</span>
      </a>
    ) : (
      <span aria-hidden="true"></span>
    )}
  </nav>

  <CodeCopy locale={locale} />
  <ImageLightbox locale={locale} />
</BaseLayout>

<!-- TOC: fixed in right margin on wide screens -->
{headings.length > 1 && (
  <aside class="hidden 2xl:block fixed z-30" style="left: calc(50% + 24rem + 1.25rem); width: 220px; top: 7rem; max-height: calc(100vh - 8rem); overflow-y: auto;">
    <TableOfContents headings={headings} locale={locale} />
  </aside>
)}