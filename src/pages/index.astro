---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SearchBarSidebar from '../components/SearchBarSidebar.astro';
import SearchBarInline from '../components/SearchBarInline.astro';
import { t, type Locale } from '../i18n/ui';

const locale: Locale = 'zh';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const rawFiles = import.meta.glob('../content/posts/*.md', { query: '?raw', eager: true });
const searchIndex = posts.map((p) => {
  const key = `../../content/posts/${p.id}.md`;
  const raw: string = (rawFiles[key] as any)?.default || '';
  return {
    id: p.id,
    title: p.data.title,
    description: p.data.description,
    publishedAt: p.data.publishedAt.toISOString(),
    tags: p.data.tags || [],
    content: raw.replace(/^---[\s\S]*?---\n?/, ''),
  };
});

const allTags = [...new Set(posts.flatMap((p) => p.data.tags || []))].sort();
---

<BaseLayout
  title={t(locale, 'site.title')}
  description={t(locale, 'site.description')}
  currentPath="/"
  locale={locale}
  contentWidth="wide"
>
  <div>
    <section class="mb-16">
      <h1 class="text-4xl font-bold tracking-tight text-neutral-900 leading-tight dark:text-neutral-100">
        {t(locale, 'home.greeting')} <span class="text-neutral-500 dark:text-neutral-400 font-medium">{'[Your Name]'}</span>
      </h1>
      <p class="mt-6 text-lg text-neutral-600 leading-relaxed max-w-xl dark:text-neutral-400">
        {t(locale, 'home.bio')}
      </p>
      <div class="mt-12 w-16 h-px bg-neutral-300 dark:bg-neutral-600" />
    </section>

    <div class="2xl:hidden mb-10">
      <SearchBarInline allTags={allTags} placeholder="搜索文章..." locale={locale} />
    </div>

    <h2 class="text-xs font-semibold uppercase tracking-[0.25em] text-neutral-500 dark:text-neutral-400 mb-8">
      {t(locale, 'home.writing')}
    </h2>

    {
      posts.length === 0 ? (
        <p class="text-neutral-500 dark:text-neutral-400">{t(locale, 'home.empty')}</p>
      ) : (
        <div id="post-list">
          {posts.map((post) => <PostCard post={post} locale={locale} />)}
        </div>
      )
    }

  </div>

  <aside class="hidden 2xl:block fixed z-30" style="left: calc(50% + 28rem + 1.5rem); width: 250px; top: 7rem;">
    <SearchBarSidebar allTags={allTags} placeholder="搜索..." locale={locale} />
  </aside>
</BaseLayout>

<script type="application/json" id="search-index-data" is:inline>
  {JSON.stringify(searchIndex)}
</script>
