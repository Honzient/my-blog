# ==============================================
# My Blog — Environment Variables
# ==============================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ==============================================

# Site metadata (used in <head>, RSS, sitemap, etc.)
# SITE_URL=https://example.com
# SITE_TITLE=My Blog
# SITE_DESCRIPTION=Personal blog about tech, design, and life.

# (Future) Analytics — e.g. Plausible, Umami, Google Analytics
# ANALYTICS_ID=

# (Future) Comment system — e.g. Giscus, Remark42, Waline
# COMMENT_SERVICE=

# (Future) Newsletter integration
# NEWSLETTER_API_KEY=
